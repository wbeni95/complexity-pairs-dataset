{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/complexity-pairs-dataset/theorems/meta.schema.json",
  "title": "Theorem note metadata",
  "description": "meta.json of a note in theorems/<id>/. See theorems/README.md for the meaning of the provenance labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "statement", "provenance", "sources", "verify"],
  "properties": {
    "id": {
      "description": "Stable slug; must equal the note's folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "statement": {
      "description": "The exact statement, self-contained, with the definitions it needs (the README has the full version).",
      "type": "string",
      "minLength": 20
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "bases"],
      "properties": {
        "class": {
          "enum": ["literature", "own-extension", "own", "undetermined"]
        },
        "bases": {
          "description": "The cited results the label rests on (short citations).",
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        },
        "pending": {
          "description": "True if a source that could not be accessed might already cover the result; the class is then provisional.",
          "type": "boolean"
        },
        "pending_note": {
          "description": "Which source is missing and what remains open.",
          "type": "string",
          "minLength": 10
        },
        "missing_sources": {
          "description": "The sources that might already contain the result but could not be read; required (non-empty) for 'undetermined', allowed only with pending. Listed in the README section 'Sources we could not read'.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/missing_source"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"class": {"enum": ["literature", "own-extension"]}}},
          "then": {"properties": {"bases": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"pending": {"const": true}}, "required": ["pending"]},
          "then": {"required": ["pending_note"]}
        },
        {
          "if": {"required": ["pending_note"]},
          "then": {"required": ["pending"], "properties": {"pending": {"const": true}}}
        },
        {
          "if": {"properties": {"pending": {"const": true}}, "required": ["pending"]},
          "then": {"properties": {"class": {"enum": ["literature", "undetermined"]}}}
        },
        {
          "if": {"properties": {"class": {"const": "undetermined"}}, "required": ["class"]},
          "then": {"required": ["pending", "pending_note", "missing_sources"], "properties": {"pending": {"const": true}}}
        },
        {
          "if": {"required": ["missing_sources"]},
          "then": {"required": ["pending"], "properties": {"pending": {"const": true}}}
        }
      ]
    },
    "proof": {
      "description": "Present only when every claim of the note has a complete written proof by this project in the repository, and deterministic checks re-run the proof's computable facts. Shown as the green check mark (✅ Proved). External citations are credit, not part of the proof. See CONTRIBUTING.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "checks", "audit"],
      "properties": {
        "documents": {
          "description": "Files, relative to the note's folder, that hold the written proofs.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "checks": {
          "description": "Deterministic scripts, relative to the note's folder, that re-check the proof's computable facts.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "audit": {
          "description": "The RESEARCH_LOG entry that records the claim-by-claim audit behind the mark.",
          "type": "string",
          "pattern": "^RL-[0-9]{3,}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "verify": {
      "description": "Command, run from the repository root, that re-checks the note; exit code 0 means every check passed.",
      "type": "string",
      "pattern": "^python theorems/[a-z0-9]+(-[a-z0-9]+)*/verify\\.py( .*)?$"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "title"],
      "properties": {
        "authors": {"type": "string"},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "title": {"type": "string"},
        "venue": {"type": "string"},
        "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"},
        "arxiv": {"type": "string", "pattern": "^(\\d{4}\\.\\d{4,5}|[a-z\\-]+(\\.[A-Z]{2})?/\\d{7})$"},
        "url": {"type": "string", "format": "uri"},
        "note": {"type": "string"}
      }
    },
    "missing_source": {
      "description": "A source that might already contain the result but could not be read, listed exactly: the full reference, a DOI or a URL, why it could not be read, and what reading it would decide.",
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "year", "title", "venue", "status", "needed_for"],
      "anyOf": [{"required": ["doi"]}, {"required": ["url"]}],
      "properties": {
        "authors": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "title": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://\\S+$"},
        "status": {
          "description": "Why it could not be read, e.g. 'publisher site refused automated access', 'not consultable until 2050', 'no open-access copy found'.",
          "type": "string",
          "minLength": 10
        },
        "needed_for": {
          "description": "What reading it would decide.",
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
